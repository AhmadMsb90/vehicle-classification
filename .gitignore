# --- Python / Environment ---
__pycache__/
*.pyc
.env
venv/
.venv/
env/

# --- Data Directory Logic ---
# Ignore all content inside these folders
data/videos/*
data/dataset_level1/train/*
data/dataset_level1/val/*

# Explicitly allow .gitkeep files so folders stay in the repo
!data/videos/.gitkeep
!data/dataset_level1/train/.gitkeep
!data/dataset_level1/val/.gitkeep

# --- Global Media / Large Files ---
# These are blocked everywhere in the project
*.mp4
*.mov
*.avi
*.mkv
*.jpg
*.jpeg
*.png
*.gif
*.bmp

# --- Models ---
# Keeping .pth and .pt files (uncomment to ignore them)
# *.pth
# *.pt
*.h5

# --- OS Specific ---
.DS_Store
